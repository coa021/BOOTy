                <mxCell id="isr_uart" value="&lt;b&gt;UART RX ISR&lt;/b&gt;&lt;br&gt;update_packet_parser_uart_callback()&lt;br&gt;&lt;br&gt;1. HAL_TIM_Base_Stop_IT(tim)&lt;br&gt;2. buffer[idx++] = rx_byte&lt;br&gt;3. HAL_UART_Receive_IT(huart, &amp;rx_byte, 1)&lt;br&gt;4. HAL_TIM_Base_Start_IT(tim)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" parent="1" vertex="1">
                    <mxGeometry x="20" y="260" width="260" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="isr_note" value="Every received byte: timer STOPS → byte appended → timer RESTARTS.&lt;br&gt;Timer only fires if no byte arrives within its period (50ms)." style="text;html=1;strokeColor=#6c8ebf;fillColor=#e8f4fd;align=left;whiteSpace=wrap;rounded=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="290" y="260" width="350" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="isr_tim" value="&lt;b&gt;TIM ISR&lt;/b&gt;&lt;br&gt;update_packet_parser_tim_callback()&lt;br&gt;&lt;br&gt;1. HAL_TIM_Base_Stop_IT(tim)&lt;br&gt;2. if idx &gt; OVERHEAD_SIZE:&lt;br&gt;   → rx_done = true&lt;br&gt;   else: tx_cb(NACK), idx = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" parent="1" vertex="1">
                    <mxGeometry x="290" y="310" width="260" height="100" as="geometry"/>
